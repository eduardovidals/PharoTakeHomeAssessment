{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "useDaemonProcess": false,
  "parallel": 2,
  "targetDefaults": {
    "test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "build": {
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
