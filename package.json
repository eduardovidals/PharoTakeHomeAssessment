{
  "name": "pharo-take-home-assessment",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "lint": "eslint apps/pharo-dashboard-ui packages scripts *.mjs",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "node scripts/nx.mjs run-many -t typecheck,typecheck:catalog,compile -p pharo-dashboard-ui,pharo-dashboard-api,@pharo/react-components,@pharo/react-form-components,@pharo/react-charts,@pharo/tailwind-plugin",
    "test": "pnpm check:routes && node scripts/nx.mjs run-many -t test,infrastructure -p pharo-dashboard-ui,pharo-dashboard-api,@pharo/eslint-config,@pharo/prettier-config,@pharo/tailwind-plugin,@pharo/react-components,@pharo/react-form-components,@pharo/react-charts",
    "build": "node scripts/nx.mjs run-many -t build -p pharo-dashboard-ui,pharo-dashboard-api,@pharo/react-components,@pharo/react-form-components,@pharo/react-charts",
    "validate": "node scripts/validate.mjs",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/dev.mjs --preview",
    "storybook": "node scripts/nx.mjs run @pharo/react-components:storybook",
    "storybook:forms": "node scripts/nx.mjs run @pharo/react-form-components:storybook",
    "storybook:charts": "node scripts/nx.mjs run @pharo/react-charts:storybook",
    "storybook:build": "node scripts/nx.mjs run-many -t storybook:build -p @pharo/react-components,@pharo/react-form-components,@pharo/react-charts",
    "test:e2e": "node scripts/nx.mjs run-many -t e2e -p pharo-dashboard-ui,@pharo/react-components,@pharo/react-form-components,@pharo/react-charts",
    "test:infrastructure": "node scripts/nx.mjs run pharo-dashboard-ui:infrastructure",
    "check:routes": "node --test scripts/route-generation.test.mjs",
    "browser:install": "node scripts/playwright.mjs install chromium"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "nx": "23.2.1",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "react-aria-components": "1.21.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/router-plugin": "1.168.42",
    "@tanstack/react-query": "5.104.1",
    "react-hook-form": "7.89.0",
    "@hookform/resolvers": "5.9.1",
    "zod": "4.6.5",
    "axios": "1.20.0",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "d3-array": "3.2.4",
    "d3-time-format": "4.1.0",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/d3-array": "3.2.2",
    "@types/d3-time-format": "4.0.3",
    "storybook": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "msw": "2.15.0",
    "@playwright/test": "1.63.0",
    "playwright": "1.63.0",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.10.1",
    "jsdom": "27.0.1",
    "tailwind-merge": "3.7.0",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "eslint-plugin-prettier": "5.5.6",
    "@pharo/eslint-config": "workspace:*",
    "@pharo/prettier-config": "workspace:*",
    "@tanstack/router-generator": "1.167.40"
  }
}
