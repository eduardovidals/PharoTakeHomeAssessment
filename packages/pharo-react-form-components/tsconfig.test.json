{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "@testing-library/jest-dom"]
  },
  "include": [
    "*.config.ts",
    "src/**/*.test.tsx",
    "src/**/*.stories.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
