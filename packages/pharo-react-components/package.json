{
  "name": "@pharo/react-components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@pharo/tailwind-plugin": "*"
  },
  "scripts": {
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --ci --no-open --disable-telemetry",
    "storybook:build": "storybook build -o storybook-static --disable-telemetry",
    "typecheck:catalog": "tsc -p .storybook/tsconfig.json",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test:unit": "node ../../scripts/vitest.mjs run --config vitest.config.ts",
    "test:stories": "node ../../scripts/vitest.mjs run --config vitest.storybook.config.ts",
    "test": "node ../../scripts/vitest.mjs run --config vitest.config.ts && node ../../scripts/vitest.mjs run --config vitest.storybook.config.ts",
    "e2e": "node ../../scripts/playwright.mjs test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "dependencies": {
    "react-aria-components": "1.21.1",
    "tailwind-merge": "3.7.0"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "build"
        ]
      },
      "test": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      },
      "storybook": {
        "dependsOn": [
          "build"
        ]
      },
      "storybook:build": {
        "dependsOn": [
          "build"
        ],
        "cache": false,
        "outputs": [
          "{projectRoot}/storybook-static"
        ]
      },
      "e2e": {
        "dependsOn": [
          "build",
          "storybook:build"
        ],
        "cache": false
      }
    }
  }
}
