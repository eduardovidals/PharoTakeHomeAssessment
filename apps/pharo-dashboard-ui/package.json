{
  "name": "@pharo/dashboard-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "nx": {
    "name": "pharo-dashboard-ui",
    "targets": {
      "test": {
        "parallelism": false
      },
      "e2e": {
        "dependsOn": [
          "build",
          {
            "target": "build",
            "projects": [
              "pharo-dashboard-api"
            ]
          }
        ],
        "cache": false
      },
      "infrastructure": {
        "executor": "nx:run-commands",
        "parallelism": false,
        "dependsOn": [
          "build",
          {
            "target": "build",
            "projects": [
              "pharo-dashboard-api"
            ]
          }
        ],
        "cache": false,
        "options": {
          "command": "node --test scripts/dev.test.mjs scripts/catalog-config.test.mjs scripts/vite-privacy.test.mjs",
          "cwd": "."
        }
      }
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "build": "vite build",
    "e2e": "node ../../scripts/playwright.mjs test"
  },
  "dependencies": {
    "react-aria-components": "1.21.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "zod": "4.6.5",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "@pharo/react-components": "workspace:*",
    "@pharo/react-charts": "workspace:*",
    "@pharo/tailwind-plugin": "workspace:*"
  }
}
